# Backend API base URL (no trailing slash). Must match backend CORS allowlist.
NEXT_PUBLIC_API_URL=http://localhost:3000
# Store currency (ISO 4217). Defaults to PKR → prices display as "Rs. …".
NEXT_PUBLIC_CURRENCY=PKR
# Storefront display name (header, footer, SEO). Defaults to SM NIMCO & Sweets.
NEXT_PUBLIC_STORE_NAME=SM NIMCO & Sweets
