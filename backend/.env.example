# Copy to .env and fill in values. Never commit .env.

DATABASE_URL="postgresql://postgres:asdf123@localhost:5432/ecommerce?schema=public"

JWT_SECRET="change-me-use-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=3000
NODE_ENV=development

# Comma-separated browser origins. MUST include every app origin (storefront + admin).
# Admin dev server is usually :3002; storefront :3001. Wrong list → CORS errors in the browser.
# Omit this line entirely to use API default: http://localhost:3001,http://localhost:3002
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

FRONTEND_URL=http://localhost:3001
APP_URL=http://localhost:3000

# Customer email branding (SM NIMCO defaults applied when unset)
# STORE_NAME=SM NIMCO & Sweets
# Absolute logo URL for email clients, or a path resolved against FRONTEND_URL (e.g. /logo.png)
# STORE_LOGO_URL=https://yourstore.com/logo.png
# STORE_BRAND_CTA=#d4af37
# STORE_SUPPORT_URL=https://yourstore.com/shipping-returns
# STORE_SOCIAL_FACEBOOK=
# STORE_SOCIAL_INSTAGRAM=
# STORE_SOCIAL_TWITTER=
# STORE_SOCIAL_LINKEDIN=

PUBLIC_BASE_URL=http://localhost:3000

DEFAULT_CURRENCY=PKR
# Alias for APP_CURRENCY (either may be set)
APP_CURRENCY=PKR

# Redis (cart / checkout). Set REDIS_ENABLED=false to skip Redis in dev.
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Email — optional env fallback (prefer Admin → Mail mailboxes for Hostinger)
# MAIL_ENABLED=true
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASS=your-mailbox-password
# MAIL_FROM_NAME=SM NIMCO & Sweets
# MAIL_FROM_ADDRESS=noreply@yourdomain.com

# Required to encrypt SMTP passwords saved in Admin → Mail (32+ chars; keep secret and stable).
# Generate: openssl rand -hex 32
MAIL_ENCRYPTION_KEY=change-me-use-a-long-random-string-at-least-32-chars

# Meta Conversions API (Direct) — server-side events paired with the browser Pixel.
# Create a System User token in Events Manager for your Pixel (never expose to the storefront).
# META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager → Test Events code while validating (remove in production).
# META_CAPI_TEST_EVENT_CODE=
# After deploy: Test Events should show Browser + Server rows with the same event_id
# (e.g. purchase_ORD-…, begin_checkout_…, atc_…). content_ids must be catalog SKUs.

# After migrate + seed, create first staff user (requires BOOTSTRAP_TOKEN):
# POST /admin/bootstrap/first-user  { "email", "password", "bootstrapToken", "firstName?", "lastName?" }
# Then sign in: POST /admin/auth/login (JWT includes typ: "admin")

# One-time token required for POST /admin/bootstrap/first-user
BOOTSTRAP_TOKEN="change-me-bootstrap-token-before-deploy"

# Optional: shared parent domain for auth cookies in production (e.g. .yourdomain.com)
# COOKIE_DOMAIN=.yourdomain.com
