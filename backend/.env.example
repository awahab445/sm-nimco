# Copy to .env and fill in values. Never commit .env.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ecommerce?schema=public"

JWT_SECRET="change-me-use-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=3000
NODE_ENV=development

# Comma-separated browser origins. MUST include every app origin (storefront + admin).
# Admin dev server is usually :3002; storefront :3001. Wrong list → CORS errors in the browser.
# Omit this line entirely to use API default: http://localhost:3001,http://localhost:3002
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

FRONTEND_URL=http://localhost:3001
APP_URL=http://localhost:3000

DEFAULT_CURRENCY=USD

# Redis (cart / checkout). Set REDIS_ENABLED=false to skip Redis in dev.
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# Email (optional in dev)
# MAIL_ENABLED=true

# Admin panel: after migrate + seed, create first staff user:
# POST /admin/bootstrap/first-user  { "email", "password", "firstName?", "lastName?" }
# Then sign in: POST /admin/auth/login (JWT includes typ: "admin")
