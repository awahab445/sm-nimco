generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id               String                        @id @default(uuid())
  sku              String                        @unique
  name             String
  slug             String                        @unique
  type             String
  description      String?
  shortDescription String?                       @map("short_description")
  basePrice        Decimal                       @map("base_price") @db.Decimal(10, 2)
  cost             Decimal?                      @db.Decimal(10, 2)
  weight           Decimal?                      @db.Decimal(10, 2)
  status           String                        @default("draft")
  visibility       String                        @default("both")
  taxClassId       String?                       @map("tax_class_id")
  attributes       Json?                         @default("{}")
  metaData         Json?                         @default("{}") @map("meta_data")
  createdAt        DateTime                      @default(now()) @map("created_at")
  updatedAt        DateTime                      @updatedAt @map("updated_at")
  deletedAt        DateTime?                     @map("deleted_at")
  inventoryItems   InventoryItem[]
  categories       ProductCategory[]
  images           ProductImage[]
  optionValues     ProductOptionValueOnProduct[]
  options          ProductOptionOnProduct[]
  variants         ProductVariant[]

  @@index([status, deletedAt])
  @@index([slug])
  @@index([sku])
  @@index([visibility, status, deletedAt])
  @@map("products")
}

model ProductVariant {
  id             String               @id @default(uuid())
  productId      String               @map("product_id")
  sku            String               @unique
  name           String
  price          Decimal              @db.Decimal(10, 2)
  cost           Decimal?             @db.Decimal(10, 2)
  weight         Decimal?             @db.Decimal(10, 2)
  attributes     Json?                @default("{}")
  position       Int                  @default(0)
  isActive       Boolean              @default(true) @map("is_active")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  inventoryItems InventoryItem[]
  images         ProductImage[]
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues   VariantOptionValue[]

  @@index([productId])
  @@index([sku])
  @@index([isActive, productId])
  @@map("product_variants")
}

model ProductOption {
  id            String                        @id @default(uuid())
  name          String
  code          String                        @unique @db.VarChar(120)
  isActive      Boolean                       @default(true) @map("is_active")
  createdAt     DateTime                      @default(now()) @map("created_at")
  updatedAt     DateTime                      @updatedAt @map("updated_at")
  values        ProductOptionValue[]
  productValues ProductOptionValueOnProduct[]
  productLinks  ProductOptionOnProduct[]
  variantLinks  VariantOptionValue[]

  @@index([isActive])
  @@index([code])
  @@map("product_options")
}

model ProductOptionValue {
  id        String                        @id @default(uuid())
  optionId  String                        @map("option_id")
  value     String
  code      String?                       @db.VarChar(120)
  sortOrder Int                           @default(0) @map("sort_order")
  isActive  Boolean                       @default(true) @map("is_active")
  createdAt DateTime                      @default(now()) @map("created_at")
  updatedAt DateTime                      @updatedAt @map("updated_at")
  option    ProductOption                 @relation(fields: [optionId], references: [id], onDelete: Cascade)
  products  ProductOptionValueOnProduct[]
  variants  VariantOptionValue[]

  @@unique([optionId, value])
  @@index([optionId, sortOrder])
  @@index([isActive])
  @@map("product_option_values")
}

model ProductOptionOnProduct {
  productId  String                        @map("product_id")
  optionId   String                        @map("option_id")
  isRequired Boolean                       @default(false) @map("is_required")
  position   Int                           @default(0)
  values     ProductOptionValueOnProduct[]
  option     ProductOption                 @relation(fields: [optionId], references: [id], onDelete: Cascade)
  product    Product                       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, optionId])
  @@index([productId, position])
  @@index([optionId])
  @@map("product_options_on_products")
}

model ProductOptionValueOnProduct {
  productId     String                 @map("product_id")
  optionId      String                 @map("option_id")
  valueId       String                 @map("value_id")
  option        ProductOption          @relation(fields: [optionId], references: [id], onDelete: Cascade)
  product       Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  productOption ProductOptionOnProduct @relation(fields: [productId, optionId], references: [productId, optionId], onDelete: Cascade)
  value         ProductOptionValue     @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([productId, optionId, valueId])
  @@index([productId, optionId])
  @@index([valueId])
  @@map("product_option_values_on_products")
}

model VariantOptionValue {
  variantId String             @map("variant_id")
  optionId  String             @map("option_id")
  valueId   String             @map("value_id")
  option    ProductOption      @relation(fields: [optionId], references: [id], onDelete: Cascade)
  value     ProductOptionValue @relation(fields: [valueId], references: [id], onDelete: Cascade)
  variant   ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([variantId, optionId])
  @@index([variantId])
  @@index([optionId])
  @@index([valueId])
  @@map("variant_option_values")
}

model ProductImage {
  id        String          @id @default(uuid())
  productId String          @map("product_id")
  variantId String?         @map("variant_id")
  url       String
  altText   String?         @map("alt_text")
  position  Int             @default(0)
  isPrimary Boolean         @default(false) @map("is_primary")
  createdAt DateTime        @default(now()) @map("created_at")
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([productId, isPrimary])
  @@index([variantId, isPrimary])
  @@map("product_images")
}

model Category {
  id                 String              @id @default(uuid())
  name               String
  slug               String              @unique
  description        String?
  parentId           String?             @map("parent_id")
  position           Int                 @default(0)
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  parent             Category?           @relation("CategoryTree", fields: [parentId], references: [id])
  children           Category[]          @relation("CategoryTree")
  products           ProductCategory[]
  storefrontNavLinks StorefrontNavLink[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

model ProductCategory {
  productId  String   @map("product_id")
  categoryId String   @map("category_id")
  position   Int      @default(0)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@index([productId])
  @@map("product_categories")
}

model InventoryItem {
  id                String                 @id @default(uuid())
  productId         String?                @map("product_id")
  variantId         String?                @map("variant_id")
  warehouseId       String                 @map("warehouse_id")
  quantity          Int                    @default(0)
  reservedQuantity  Int                    @default(0) @map("reserved_quantity")
  availableQuantity Int                    @default(0) @map("available_quantity")
  lowStockThreshold Int                    @default(10) @map("low_stock_threshold")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  product           Product?               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant?        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  reservations      InventoryReservation[]

  @@unique([productId, variantId, warehouseId])
  @@index([productId])
  @@index([variantId])
  @@index([availableQuantity])
  @@map("inventory_items")
}

model InventoryReservation {
  id              String        @id @default(uuid())
  inventoryItemId String        @map("inventory_item_id")
  referenceType   String        @map("reference_type")
  referenceId     String        @map("reference_id")
  quantity        Int
  expiresAt       DateTime      @map("expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([referenceType, referenceId])
  @@index([expiresAt])
  @@map("inventory_reservations")
}

model Order {
  id                String         @id @default(uuid())
  orderNumber       String         @unique @map("order_number") @db.VarChar(50)
  customerId        String?        @map("customer_id") @db.Uuid
  customerGroupId   String?        @map("customer_group_id") @db.Uuid
  status            String         @default("pending") @db.VarChar(50)
  paymentStatus     String?        @default("pending") @map("payment_status") @db.VarChar(50)
  fulfillmentStatus String?        @default("unfulfilled") @map("fulfillment_status") @db.VarChar(50)
  customerEmail     String         @map("customer_email") @db.VarChar(255)
  customerName      String?        @map("customer_name") @db.VarChar(255)
  billingAddress    Json           @map("billing_address")
  shippingAddress   Json           @map("shipping_address")
  currency          String         @default("USD") @db.VarChar(3)
  subtotal          Decimal        @db.Decimal(12, 2)
  discountTotal     Decimal        @default(0) @map("discount_total") @db.Decimal(12, 2)
  shippingTotal     Decimal        @default(0) @map("shipping_total") @db.Decimal(12, 2)
  taxTotal          Decimal        @default(0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal        Decimal        @map("grand_total") @db.Decimal(12, 2)
  appliedPriceRules Json           @default("[]") @map("applied_price_rules")
  ipAddress         String?        @map("ip_address") @db.Inet
  userAgent         String?        @map("user_agent")
  notes             String?
  metadata          Json           @default("{}")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  cancelledAt       DateTime?      @map("cancelled_at")
  completedAt       DateTime?      @map("completed_at")
  items             OrderItem[]
  shipping          OrderShipping?
  taxes             OrderTax[]
  customer          Customer?      @relation(fields: [customerId], references: [id])

  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(uuid())
  orderId           String   @map("order_id")
  productId         String   @map("product_id")
  variantId         String?  @map("variant_id")
  sku               String   @db.VarChar(100)
  name              String   @db.VarChar(500)
  attributes        Json     @default("{}")
  quantity          Int
  unitPrice         Decimal  @map("unit_price") @db.Decimal(12, 2)
  discountAmount    Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount         Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  rowTotal          Decimal  @map("row_total") @db.Decimal(12, 2)
  quantityFulfilled Int      @default(0) @map("quantity_fulfilled")
  quantityRefunded  Int      @default(0) @map("quantity_refunded")
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model PaymentMethod {
  id        String    @id @default(uuid())
  code      String    @unique @db.VarChar(50)
  name      String    @db.VarChar(255)
  provider  String    @db.VarChar(50)
  flowType  String    @map("flow_type") @db.VarChar(50)
  isActive  Boolean   @default(true) @map("is_active")
  config    Json      @default("{}")
  metadata  Json      @default("{}")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  payments  Payment[]

  @@index([code])
  @@index([provider])
  @@index([isActive])
  @@map("payment_methods")
}

model Payment {
  id                   String        @id @default(uuid())
  orderId              String        @map("order_id")
  paymentMethodId      String        @map("payment_method_id")
  status               String        @default("pending") @db.VarChar(50)
  flowType             String        @map("flow_type") @db.VarChar(50)
  amount               Decimal       @db.Decimal(12, 2)
  currency             String        @db.VarChar(3)
  gatewayTransactionId String?       @map("gateway_transaction_id") @db.VarChar(255)
  clientSecret         String?       @map("client_secret")
  redirectUrl          String?       @map("redirect_url")
  gatewayResponse      Json?         @default("{}") @map("gateway_response")
  capturedAt           DateTime?     @map("captured_at")
  failedAt             DateTime?     @map("failed_at")
  refundedAt           DateTime?     @map("refunded_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  paymentMethod        PaymentMethod @relation(fields: [paymentMethodId], references: [id])

  @@index([orderId])
  @@index([paymentMethodId])
  @@index([status])
  @@index([gatewayTransactionId])
  @@index([createdAt(sort: Desc)])
  @@map("payments")
}

model Promotion {
  id                      String                   @id @default(uuid())
  code                    String?                  @unique @db.VarChar(100)
  name                    String                   @db.VarChar(255)
  description             String?
  type                    String                   @db.VarChar(50)
  status                  String                   @default("draft") @db.VarChar(50)
  discountValue           Decimal?                 @map("discount_value") @db.Decimal(10, 2)
  discountType            String                   @map("discount_type") @db.VarChar(50)
  scope                   String                   @default("cart") @db.VarChar(50)
  isStackable             Boolean                  @default(false) @map("is_stackable")
  isExclusive             Boolean                  @default(true) @map("is_exclusive")
  appliesToAllGroups      Boolean                  @default(false) @map("applies_to_all_groups")
  conditions              Json                     @default("{}")
  usageLimit              Int?                     @map("usage_limit")
  usageLimitPerUser       Int?                     @map("usage_limit_per_user")
  currentUsage            Int                      @default(0) @map("current_usage")
  startDate               DateTime?                @map("start_date")
  endDate                 DateTime?                @map("end_date")
  metadata                Json                     @default("{}")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  promotionCustomerGroups PromotionCustomerGroup[]
  promotionLogs           PromotionLog[]
  promotionProducts       PromotionProduct[]

  @@index([code])
  @@index([status])
  @@index([startDate, endDate])
  @@index([status, startDate, endDate])
  @@map("promotions")
}

model PromotionProduct {
  id          String    @id @default(uuid())
  promotionId String    @map("promotion_id")
  productId   String?   @map("product_id")
  variantId   String?   @map("variant_id")
  categoryId  String?   @map("category_id")
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([productId])
  @@index([variantId])
  @@index([categoryId])
  @@map("promotion_products")
}

model PromotionCustomerGroup {
  id              String        @id @default(uuid())
  promotionId     String        @map("promotion_id")
  customerGroupId String        @map("customer_group_id") @db.Uuid
  isExcluded      Boolean       @default(false) @map("is_excluded")
  customerGroup   CustomerGroup @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)
  promotion       Promotion     @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, customerGroupId])
  @@index([promotionId])
  @@index([customerGroupId])
  @@index([promotionId, isExcluded])
  @@map("promotion_customer_groups")
}

model PromotionLog {
  id             String    @id @default(uuid())
  promotionId    String    @map("promotion_id")
  cartId         String?   @map("cart_id")
  checkoutId     String?   @map("checkout_id")
  orderId        String?   @map("order_id")
  customerId     String?   @map("customer_id")
  couponCode     String?   @map("coupon_code") @db.VarChar(100)
  discountAmount Decimal   @map("discount_amount") @db.Decimal(12, 2)
  subtotalBefore Decimal   @map("subtotal_before") @db.Decimal(12, 2)
  subtotalAfter  Decimal   @map("subtotal_after") @db.Decimal(12, 2)
  status         String    @db.VarChar(50)
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at")
  promotion      Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([cartId])
  @@index([checkoutId])
  @@index([orderId])
  @@index([customerId])
  @@index([couponCode])
  @@index([createdAt(sort: Desc)])
  @@map("promotion_logs")
}

model ShippingZone {
  id          String           @id @default(uuid())
  name        String           @db.VarChar(255)
  description String?
  coverage    Json             @default("{}")
  priority    Int              @default(0)
  isActive    Boolean          @default(true) @map("is_active")
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  methods     ShippingMethod[]

  @@index([isActive, priority])
  @@index([priority])
  @@map("shipping_zones")
}

model ShippingMethod {
  id             String                        @id @default(uuid())
  zoneId         String                        @map("zone_id")
  code           String                        @db.VarChar(100)
  name           String                        @db.VarChar(255)
  description    String?
  type           String                        @db.VarChar(50)
  config         Json                          @default("{}")
  minOrderAmount Decimal?                      @map("min_order_amount") @db.Decimal(12, 2)
  maxOrderAmount Decimal?                      @map("max_order_amount") @db.Decimal(12, 2)
  minWeight      Decimal?                      @map("min_weight") @db.Decimal(10, 2)
  maxWeight      Decimal?                      @map("max_weight") @db.Decimal(10, 2)
  priority       Int                           @default(0)
  isActive       Boolean                       @default(true) @map("is_active")
  courierConfig  Json?                         @default("{}") @map("courier_config")
  metadata       Json                          @default("{}")
  createdAt      DateTime                      @default(now()) @map("created_at")
  updatedAt      DateTime                      @updatedAt @map("updated_at")
  orderShippings OrderShipping[]
  customerGroups ShippingMethodCustomerGroup[]
  zone           ShippingZone                  @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@index([zoneId])
  @@index([code])
  @@index([isActive, priority])
  @@index([type])
  @@map("shipping_methods")
}

model OrderShipping {
  id               String         @id @default(uuid())
  orderId          String         @unique @map("order_id")
  shippingMethodId String         @map("shipping_method_id")
  cost             Decimal        @db.Decimal(12, 2)
  currency         String         @db.VarChar(3)
  status           String         @default("pending") @db.VarChar(50)
  trackingNumber   String?        @map("tracking_number") @db.VarChar(255)
  trackingUrl      String?        @map("tracking_url")
  courierCode      String?        @map("courier_code") @db.VarChar(50)
  courierName      String?        @map("courier_name") @db.VarChar(255)
  shippedAt        DateTime?      @map("shipped_at")
  deliveredAt      DateTime?      @map("delivered_at")
  cancelledAt      DateTime?      @map("cancelled_at")
  shippingAddress  Json           @map("shipping_address")
  metadata         Json           @default("{}")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shippingMethod   ShippingMethod @relation(fields: [shippingMethodId], references: [id])

  @@index([orderId])
  @@index([shippingMethodId])
  @@index([status])
  @@index([trackingNumber])
  @@index([courierCode])
  @@index([shippedAt])
  @@map("order_shipping")
}

model ShippingMethodCustomerGroup {
  id               String         @id @default(uuid())
  shippingMethodId String         @map("shipping_method_id")
  customerGroupId  String         @map("customer_group_id") @db.Uuid
  discountPercent  Decimal?       @map("discount_percent") @db.Decimal(5, 2)
  fixedCost        Decimal?       @map("fixed_cost") @db.Decimal(12, 2)
  metadata         Json           @default("{}")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  customerGroup    CustomerGroup  @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)
  shippingMethod   ShippingMethod @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade)

  @@unique([shippingMethodId, customerGroupId])
  @@index([shippingMethodId])
  @@index([customerGroupId])
  @@map("shipping_method_customer_groups")
}

model TaxClass {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  taxes       Tax[]

  @@index([code])
  @@map("tax_classes")
}

model Tax {
  id          String     @id @default(uuid())
  taxClassId  String     @map("tax_class_id")
  country     String     @db.VarChar(2)
  region      String?    @db.VarChar(100)
  rate        Decimal    @db.Decimal(5, 4)
  isInclusive Boolean    @default(false) @map("is_inclusive")
  isActive    Boolean    @default(true) @map("is_active")
  startDate   DateTime?  @map("start_date")
  endDate     DateTime?  @map("end_date")
  metadata    Json       @default("{}")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  orderTaxes  OrderTax[]
  taxClass    TaxClass   @relation(fields: [taxClassId], references: [id], onDelete: Cascade)

  @@index([taxClassId])
  @@index([country, region])
  @@index([isActive])
  @@index([startDate, endDate])
  @@index([country, region, taxClassId, isActive])
  @@map("taxes")
}

model OrderTax {
  id            String   @id @default(uuid())
  orderId       String   @map("order_id")
  taxId         String   @map("tax_id")
  taxClassId    String   @map("tax_class_id")
  taxClassCode  String   @map("tax_class_code") @db.VarChar(50)
  taxClassName  String   @map("tax_class_name") @db.VarChar(255)
  country       String   @map("country") @db.VarChar(2)
  region        String?  @map("region") @db.VarChar(100)
  rate          Decimal  @map("rate") @db.Decimal(5, 4)
  isInclusive   Boolean  @map("is_inclusive")
  taxableAmount Decimal  @map("taxable_amount") @db.Decimal(12, 2)
  taxAmount     Decimal  @map("tax_amount") @db.Decimal(12, 2)
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tax           Tax      @relation(fields: [taxId], references: [id])

  @@index([orderId])
  @@index([taxId])
  @@index([taxClassId])
  @@map("order_taxes")
}

model CustomerGroup {
  id                           String                        @id @default(uuid()) @db.Uuid
  name                         String                        @db.VarChar(255)
  description                  String?
  isDefault                    Boolean                       @default(false) @map("is_default")
  taxClassId                   String?                       @map("tax_class_id") @db.Uuid
  discountPercent              Decimal?                      @map("discount_percent") @db.Decimal(5, 2)
  metadata                     Json                          @default("{}")
  createdAt                    DateTime                      @default(now()) @map("created_at")
  updatedAt                    DateTime                      @updatedAt @map("updated_at")
  customers                    Customer[]
  promotionCustomerGroups      PromotionCustomerGroup[]
  shippingMethodCustomerGroups ShippingMethodCustomerGroup[]

  @@index([isDefault])
  @@index([taxClassId])
  @@map("customer_groups")
}

model Customer {
  id                     String            @id @default(uuid()) @db.Uuid
  email                  String            @unique @db.VarChar(255)
  passwordHash           String?           @map("password_hash") @db.VarChar(255)
  firstName              String?           @map("first_name") @db.VarChar(255)
  lastName               String?           @map("last_name") @db.VarChar(255)
  phone                  String?           @db.VarChar(50)
  isGuest                Boolean           @default(false) @map("is_guest")
  isEmailVerified        Boolean           @default(false) @map("is_email_verified")
  emailVerificationToken String?           @unique @map("email_verification_token") @db.VarChar(255)
  resetPasswordToken     String?           @unique @map("reset_password_token") @db.VarChar(255)
  resetPasswordExpires   DateTime?         @map("reset_password_expires") @db.Timestamptz(6)
  customerGroupId        String            @map("customer_group_id") @db.Uuid
  metadata               Json              @default("{}")
  createdAt              DateTime          @default(now()) @map("created_at")
  updatedAt              DateTime          @updatedAt @map("updated_at")
  addresses              CustomerAddress[]
  customerGroup          CustomerGroup     @relation(fields: [customerGroupId], references: [id])
  orders                 Order[]

  @@index([email])
  @@index([customerGroupId])
  @@index([isGuest])
  @@index([emailVerificationToken])
  @@index([resetPasswordToken])
  @@map("customers")
}

model AccountCreationToken {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @db.VarChar(255)
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@map("account_creation_tokens")
}

model CustomerAddress {
  id                String   @id @default(uuid()) @db.Uuid
  customerId        String   @map("customer_id") @db.Uuid
  label             String?  @db.VarChar(100)
  firstName         String   @map("first_name") @db.VarChar(255)
  lastName          String   @map("last_name") @db.VarChar(255)
  company           String?  @db.VarChar(255)
  addressLine1      String   @map("address_line1") @db.VarChar(500)
  addressLine2      String?  @map("address_line2") @db.VarChar(500)
  city              String   @db.VarChar(255)
  state             String   @db.VarChar(255)
  postalCode        String   @map("postal_code") @db.VarChar(50)
  country           String   @db.VarChar(2)
  phone             String?  @db.VarChar(50)
  isDefaultBilling  Boolean  @default(false) @map("is_default_billing")
  isDefaultShipping Boolean  @default(false) @map("is_default_shipping")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model AdminPermission {
  id          String                @id @default(uuid()) @db.Uuid
  key         String                @unique @db.VarChar(120)
  description String?               @db.VarChar(500)
  createdAt   DateTime              @default(now()) @map("created_at")
  roles       AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRole {
  id          String                @id @default(uuid()) @db.Uuid
  slug        String                @unique @db.VarChar(64)
  name        String                @db.VarChar(128)
  description String?
  isSystem    Boolean               @default(false) @map("is_system")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  permissions AdminRolePermission[]
  users       AdminUserRole[]

  @@map("admin_roles")
}

model AdminRolePermission {
  roleId       String          @map("role_id") @db.Uuid
  permissionId String          @map("permission_id") @db.Uuid
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminUser {
  id           String          @id @default(uuid()) @db.Uuid
  email        String          @unique @db.VarChar(255)
  passwordHash String          @map("password_hash") @db.VarChar(255)
  firstName    String?         @map("first_name") @db.VarChar(255)
  lastName     String?         @map("last_name") @db.VarChar(255)
  isActive     Boolean         @default(true) @map("is_active")
  lastLoginAt  DateTime?       @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  roles        AdminUserRole[]

  @@index([email])
  @@index([isActive])
  @@map("admin_users")
}

model AdminUserRole {
  userId String    @map("user_id") @db.Uuid
  roleId String    @map("role_id") @db.Uuid
  role   AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user   AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("admin_user_roles")
}

model CmsPage {
  id              String    @id @default(uuid())
  title           String    @db.VarChar(255)
  slug            String    @unique @db.VarChar(255)
  status          String    @default("draft") @db.VarChar(32)
  excerpt         String?
  metaTitle       String?   @map("meta_title") @db.VarChar(255)
  metaDescription String?   @map("meta_description")
  contentHtml     String?   @map("content_html")
  contentJson     Json?     @default("{}") @map("content_json")
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([slug, status])
  @@index([status, updatedAt(sort: Desc)])
  @@map("cms_pages")
}

model CmsBlock {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(255)
  identifier  String   @unique @db.VarChar(255)
  description String?
  contentHtml String?  @map("content_html")
  contentJson Json?    @default("{}") @map("content_json")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([identifier, isActive])
  @@map("cms_blocks")
}

model CmsBannerSlider {
  id            String           @id @default(uuid())
  name          String           @db.VarChar(255)
  identifier    String           @unique @db.VarChar(255)
  isActive      Boolean          @default(true) @map("is_active")
  autoplayMs    Int?             @map("autoplay_ms")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  /// * Design / layout height in px — same for every slide; optional (use with width for fixed aspect).
  slideHeightPx Int?             @map("slide_height_px")
  /// * Design / layout width in px — same for every slide in this slider (optional).
  slideWidthPx  Int?             @map("slide_width_px")
  slides        CmsBannerSlide[]

  @@index([identifier, isActive])
  @@map("cms_banner_sliders")
}

model CmsBannerSlide {
  id        String          @id @default(uuid())
  sliderId  String          @map("slider_id")
  title     String          @db.VarChar(255)
  subtitle  String?
  imageUrl  String          @map("image_url")
  ctaLabel  String?         @map("cta_label") @db.VarChar(120)
  ctaHref   String?         @map("cta_href") @db.VarChar(500)
  sortOrder Int             @default(0) @map("sort_order")
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  slider    CmsBannerSlider @relation(fields: [sliderId], references: [id], onDelete: Cascade)

  @@index([sliderId, sortOrder])
  @@index([sliderId, isActive])
  @@map("cms_banner_slides")
}

model Subscriber {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique @db.VarChar(255)
  source    String?  @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([createdAt(sort: Desc)])
  @@map("subscribers")
}

model StorefrontFilter {
  id              String                     @id @default(uuid()) @db.Uuid
  code            String                     @unique @db.VarChar(64)
  name            String                     @db.VarChar(255)
  kind            String                     @db.VarChar(32)
  sortOrder       Int                        @default(0) @map("sort_order")
  isActive        Boolean                    @default(true) @map("is_active")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")
  options         StorefrontFilterOption[]
  browseTreeNodes StorefrontFilterTreeNode[]

  @@index([isActive, sortOrder])
  @@map("storefront_filters")
}

/// * PLP side-rail browse tree (synced from Store navigation mega menu; managed under Store filters).
model StorefrontFilterTreeNode {
  id        String                     @id @default(uuid()) @db.Uuid
  filterId  String                     @map("filter_id") @db.Uuid
  parentId  String?                    @map("parent_id") @db.Uuid
  /// * Source row in Store navigation (mega zone) for label, href, and category.
  navLinkId String?                    @map("nav_link_id") @db.Uuid
  sortOrder Int                        @default(0) @map("sort_order")
  isActive  Boolean                    @default(true) @map("is_active")
  createdAt DateTime                   @default(now()) @map("created_at")
  updatedAt DateTime                   @updatedAt @map("updated_at")
  filter    StorefrontFilter           @relation(fields: [filterId], references: [id], onDelete: Cascade)
  navLink   StorefrontNavLink?         @relation(fields: [navLinkId], references: [id])
  parent    StorefrontFilterTreeNode?  @relation("FilterBrowseTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  StorefrontFilterTreeNode[] @relation("FilterBrowseTree")

  @@unique([filterId, navLinkId])
  @@index([filterId, parentId, sortOrder])
  @@index([filterId, isActive, sortOrder])
  @@map("storefront_filter_tree_nodes")
}

model StorefrontFilterOption {
  id        String           @id @default(uuid()) @db.Uuid
  filterId  String           @map("filter_id") @db.Uuid
  value     String           @db.VarChar(255)
  label     String?          @db.VarChar(255)
  sortOrder Int              @default(0) @map("sort_order")
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")
  filter    StorefrontFilter @relation(fields: [filterId], references: [id], onDelete: Cascade)

  @@unique([filterId, value])
  @@index([filterId, isActive, sortOrder])
  @@map("storefront_filter_options")
}

model StorefrontNavLink {
  id              String                     @id @default(uuid()) @db.Uuid
  label           String                     @db.VarChar(128)
  secondaryLabel  String?                    @map("secondary_label") @db.VarChar(128)
  href            String                     @default("") @db.VarChar(512)
  sortOrder       Int                        @default(0) @map("sort_order")
  isActive        Boolean                    @default(true) @map("is_active")
  /// * header bar link, or legacy MEGA_CATEGORIES (migrated to openMegaMenu).
  kind            String                     @default("LINK") @db.VarChar(32)
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")
  /// * header = top bar; mega = layered mega menu tree
  zone            String                     @default("header") @db.VarChar(16)
  parentId        String?                    @map("parent_id") @db.Uuid
  categoryId      String?                    @map("category_id")
  /// * Header item that opens the mega menu panel (replaces MEGA_CATEGORIES kind).
  openMegaMenu    Boolean                    @default(false) @map("open_mega_menu")
  /// * Promo image in mega menu right column (header item with openMegaMenu).
  bannerImageUrl  String?                    @map("banner_image_url") @db.VarChar(512)
  bannerHref      String?                    @map("banner_href") @db.VarChar(512)
  bannerAlt       String?                    @map("banner_alt") @db.VarChar(256)
  filterTreeNodes StorefrontFilterTreeNode[]
  category        Category?                  @relation(fields: [categoryId], references: [id])
  parent          StorefrontNavLink?         @relation("StorefrontNavTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        StorefrontNavLink[]        @relation("StorefrontNavTree")

  @@index([isActive, sortOrder])
  @@index([zone, parentId, sortOrder])
  @@map("storefront_nav_links")
}

/// SMTP mailbox for outbound email, routed by purpose (ORDERS, WELCOME, AUTH, etc.).
model MailMailbox {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  purpose     String   @db.VarChar(50)
  smtpHost    String   @map("smtp_host") @db.VarChar(255)
  smtpPort    Int      @default(587) @map("smtp_port")
  smtpSecure  Boolean  @default(false) @map("smtp_secure")
  smtpUser    String   @map("smtp_user") @db.VarChar(255)
  smtpPassEnc String   @map("smtp_pass_enc") @db.Text
  fromName    String   @map("from_name") @db.VarChar(255)
  fromAddress String   @map("from_address") @db.VarChar(255)
  isActive    Boolean  @default(true) @map("is_active")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([purpose, isActive])
  @@index([purpose, isDefault])
  @@map("mail_mailboxes")
}

/// Singleton GA4 analytics configuration (id is always "default").
model AnalyticsGa4Settings {
  id                   String   @id @default("default")
  measurementId        String?  @map("measurement_id") @db.VarChar(32)
  isEnabled            Boolean  @default(false) @map("is_enabled")
  debugMode            Boolean  @default(false) @map("debug_mode")
  trackPageViews       Boolean  @default(true) @map("track_page_views")
  trackCartEvents      Boolean  @default(true) @map("track_cart_events")
  trackCheckoutSteps   Boolean  @default(true) @map("track_checkout_steps")
  trackPurchases       Boolean  @default(true) @map("track_purchases")
  trackRefunds         Boolean  @default(false) @map("track_refunds")
  trackCustomEvents    Boolean  @default(true) @map("track_custom_events")
  anonymizeIp          Boolean  @default(true) @map("anonymize_ip")
  currency             String   @default("PKR") @db.VarChar(3)
  updatedAt            DateTime @updatedAt @map("updated_at")
  updatedByAdminUserId String?  @map("updated_by_admin_user_id")

  @@map("analytics_ga4_settings")
}
