// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
   url      = env("DATABASE_URL")
}

model Product {
  id               String   @id @default(uuid())
  sku              String   @unique
  name             String
  slug             String   @unique
  type             String   // simple | configurable | bundle | virtual
  description      String?  @db.Text
  shortDescription String?  @map("short_description")
  basePrice        Decimal  @map("base_price") @db.Decimal(10, 2)
  cost             Decimal? @db.Decimal(10, 2)
  weight           Decimal? @db.Decimal(10, 2)
  status           String   @default("draft") // draft | active | disabled
  visibility       String   @default("both") // catalog | search | both | none
  taxClassId       String?  @map("tax_class_id")
  attributes       Json?    @default("{}")
  metaData         Json?    @map("meta_data") @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  variants  ProductVariant[]
  images    ProductImage[]
  categories ProductCategory[]
  inventoryItems InventoryItem[]

  @@index([status, deletedAt])
  @@index([slug])
  @@index([sku])
  @@index([visibility, status, deletedAt])
  @@map("products")
}

model ProductVariant {
  id         String    @id @default(uuid())
  productId  String    @map("product_id")
  sku        String    @unique
  name       String
  price      Decimal   @db.Decimal(10, 2)
  cost       Decimal?  @db.Decimal(10, 2)
  weight     Decimal?  @db.Decimal(10, 2)
  attributes Json?     @default("{}")
  position   Int       @default(0)
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  images  ProductImage[]
  inventoryItems InventoryItem[]

  @@index([productId])
  @@index([sku])
  @@index([isActive, productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  variantId String?  @map("variant_id")
  url       String
  altText   String?  @map("alt_text")
  position  Int      @default(0)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  product Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([productId, isPrimary])
  @@index([variantId, isPrimary])
  @@map("product_images")
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  parentId    String?   @map("parent_id")
  position    Int       @default(0)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@index([slug])
  @@index([parentId])
  @@index([isActive])
  @@map("categories")
}

model ProductCategory {
  productId  String   @map("product_id")
  categoryId String   @map("category_id")
  position   Int      @default(0)

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@index([productId])
  @@map("product_categories")
}

// ============================================================================
// INVENTORY DOMAIN
// ============================================================================

model InventoryItem {
  id                 String   @id @default(uuid())
  productId          String?  @map("product_id")
  variantId          String?  @map("variant_id")
  warehouseId        String   @map("warehouse_id")
  quantity           Int      @default(0)
  reservedQuantity   Int      @default(0) @map("reserved_quantity")
  availableQuantity  Int      @default(0) @map("available_quantity")
  lowStockThreshold  Int      @default(10) @map("low_stock_threshold")
  updatedAt          DateTime @updatedAt @map("updated_at")

  product Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  reservations InventoryReservation[]

  @@unique([productId, variantId, warehouseId])
  @@index([productId])
  @@index([variantId])
  @@index([availableQuantity])
  @@map("inventory_items")
}

model InventoryReservation {
  id              String   @id @default(uuid())
  inventoryItemId String   @map("inventory_item_id")
  referenceType   String   @map("reference_type")
  referenceId     String   @map("reference_id")
  quantity        Int
  expiresAt       DateTime @map("expires_at")
  createdAt       DateTime @default(now()) @map("created_at")

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([referenceType, referenceId])
  @@index([expiresAt])
  @@map("inventory_reservations")
}

// ============================================================================
// ORDER DOMAIN
// ============================================================================

model Order {
  id                String    @id @default(uuid())
  orderNumber       String    @unique @map("order_number") @db.VarChar(50)
  customerId        String?   @map("customer_id") @db.Uuid
  customerGroupId   String?   @map("customer_group_id") @db.Uuid
  status            String    @default("pending") @db.VarChar(50) // pending, processing, completed, cancelled
  paymentStatus     String?   @default("pending") @map("payment_status") @db.VarChar(50)
  fulfillmentStatus String?   @default("unfulfilled") @map("fulfillment_status") @db.VarChar(50)
  
  // Immutable customer snapshot
  customerEmail     String    @map("customer_email") @db.VarChar(255)
  customerName      String?   @map("customer_name") @db.VarChar(255)
  
  // Immutable addresses
  billingAddress    Json      @map("billing_address")
  shippingAddress   Json      @map("shipping_address")
  
  // Pricing
  currency          String    @default("USD") @db.VarChar(3)
  subtotal          Decimal   @db.Decimal(12, 2)
  discountTotal     Decimal   @default(0) @map("discount_total") @db.Decimal(12, 2)
  shippingTotal     Decimal   @default(0) @map("shipping_total") @db.Decimal(12, 2)
  taxTotal          Decimal   @default(0) @map("tax_total") @db.Decimal(12, 2)
  grandTotal        Decimal   @map("grand_total") @db.Decimal(12, 2)
  
  // Applied rules snapshot
  appliedPriceRules Json      @default("[]") @map("applied_price_rules")
  
  // Metadata
  ipAddress         String?   @map("ip_address") @db.Inet
  userAgent         String?   @map("user_agent") @db.Text
  notes             String?   @db.Text
  metadata          Json      @default("{}")
  
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  cancelledAt       DateTime? @map("cancelled_at")
  completedAt       DateTime? @map("completed_at")
  
  items             OrderItem[]
  shipping          OrderShipping?
  taxes             OrderTax[]
  customer          Customer? @relation(fields: [customerId], references: [id])

  @@index([orderNumber])
  @@index([customerId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id                String   @id @default(uuid())
  orderId           String   @map("order_id")
  
  // Product snapshot (immutable)
  productId         String   @map("product_id")
  variantId         String?  @map("variant_id")
  sku               String   @db.VarChar(100)
  name              String   @db.VarChar(500)
  attributes        Json     @default("{}")
  
  // Pricing snapshot
  quantity          Int
  unitPrice         Decimal  @map("unit_price") @db.Decimal(12, 2)
  discountAmount    Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxAmount         Decimal  @default(0) @map("tax_amount") @db.Decimal(12, 2)
  rowTotal          Decimal  @map("row_total") @db.Decimal(12, 2)
  
  // Fulfillment
  quantityFulfilled Int      @default(0) @map("quantity_fulfilled")
  quantityRefunded  Int      @default(0) @map("quantity_refunded")
  
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")
  
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ============================================================================
// PAYMENT DOMAIN
// ============================================================================

model PaymentMethod {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(50) // stripe, easypaisa, jazzcash, ubl, hbl
  name        String   @db.VarChar(255)
  provider    String   @db.VarChar(50) // stripe, easypaisa, jazzcash, ubl, hbl
  flowType    String   @map("flow_type") @db.VarChar(50) // CLIENT_SECRET, REDIRECT, HOSTED_PAGE
  isActive    Boolean  @default(true) @map("is_active")
  config      Json     @default("{}") // Gateway-specific configuration (credentials, endpoints, etc.)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  payments    Payment[]

  @@index([code])
  @@index([provider])
  @@index([isActive])
  @@map("payment_methods")
}

model Payment {
  id                  String    @id @default(uuid())
  orderId             String    @map("order_id")
  paymentMethodId     String    @map("payment_method_id")
  status              String    @default("pending") @db.VarChar(50) // pending, processing, captured, failed, refunded
  flowType            String    @map("flow_type") @db.VarChar(50) // CLIENT_SECRET, REDIRECT, HOSTED_PAGE
  
  // Amounts
  amount              Decimal   @db.Decimal(12, 2)
  currency            String    @db.VarChar(3)
  
  // Gateway identifiers
  gatewayTransactionId String?  @map("gateway_transaction_id") @db.VarChar(255)
  clientSecret        String?  @map("client_secret") @db.Text
  redirectUrl         String?  @map("redirect_url") @db.Text
  
  // Gateway response (full response stored as JSON)
  gatewayResponse     Json?     @map("gateway_response") @default("{}")
  
  // Timestamps
  capturedAt          DateTime? @map("captured_at")
  failedAt            DateTime? @map("failed_at")
  refundedAt          DateTime? @map("refunded_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  
  paymentMethod       PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  
  @@index([orderId])
  @@index([paymentMethodId])
  @@index([status])
  @@index([gatewayTransactionId])
  @@index([createdAt(sort: Desc)])
  @@map("payments")
}

// ============================================================================
// PROMOTIONS DOMAIN
// ============================================================================

model Promotion {
  id                String    @id @default(uuid())
  code              String?   @unique @db.VarChar(100) // Coupon code (nullable for automatic promotions)
  name              String    @db.VarChar(255)
  description       String?   @db.Text
  type              String    @db.VarChar(50) // percentage | fixed_amount | buy_x_get_y | free_shipping
  status            String    @default("draft") @db.VarChar(50) // draft | active | expired | disabled
  
  // Discount configuration
  discountValue     Decimal?  @map("discount_value") @db.Decimal(10, 2) // Percentage or fixed amount
  discountType      String    @map("discount_type") @db.VarChar(50) // percentage | fixed_amount
  
  // Scope
  scope             String    @default("cart") @db.VarChar(50) // cart | product | category
  isStackable       Boolean   @default(false) @map("is_stackable")
  isExclusive       Boolean   @default(true) @map("is_exclusive")
  
  // Customer group targeting
  appliesToAllGroups Boolean  @default(false) @map("applies_to_all_groups") // true = all groups, false = specific groups only
  
  // Eligibility conditions (stored as JSONB for flexibility)
  conditions        Json      @default("{}") // { minOrderAmount, products, categories, etc. }
  
  // Usage limits
  usageLimit        Int?      @map("usage_limit") // Total usage limit
  usageLimitPerUser Int?      @map("usage_limit_per_user") // Per-user usage limit
  currentUsage      Int       @default(0) @map("current_usage")
  
  // Validity period
  startDate         DateTime? @map("start_date")
  endDate           DateTime? @map("end_date")
  
  // Metadata
  metadata          Json      @default("{}")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  
  promotionProducts PromotionProduct[]
  promotionCustomerGroups PromotionCustomerGroup[]
  promotionLogs     PromotionLog[]

  @@index([code])
  @@index([status])
  @@index([startDate, endDate])
  @@index([status, startDate, endDate])
  @@map("promotions")
}

model PromotionProduct {
  id          String   @id @default(uuid())
  promotionId String   @map("promotion_id")
  productId   String?  @map("product_id") // Nullable for category-level promotions
  variantId   String?  @map("variant_id") // Nullable for product-level promotions
  categoryId  String?  @map("category_id") // Nullable for product-level promotions
  
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([productId])
  @@index([variantId])
  @@index([categoryId])
  @@map("promotion_products")
}

model PromotionCustomerGroup {
  id                String   @id @default(uuid())
  promotionId       String   @map("promotion_id")
  customerGroupId   String   @map("customer_group_id") @db.Uuid
  isExcluded        Boolean  @default(false) @map("is_excluded") // true = excluded, false = eligible
  
  promotion         Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  customerGroup     CustomerGroup @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)

  @@unique([promotionId, customerGroupId])
  @@index([promotionId])
  @@index([customerGroupId])
  @@index([promotionId, isExcluded])
  @@map("promotion_customer_groups")
}

model PromotionLog {
  id          String    @id @default(uuid())
  promotionId String    @map("promotion_id")
  
  // Context
  cartId      String?   @map("cart_id")
  checkoutId  String?   @map("checkout_id")
  orderId     String?   @map("order_id")
  customerId  String?   @map("customer_id")
  couponCode  String?   @map("coupon_code") @db.VarChar(100)
  
  // Discount applied
  discountAmount Decimal @map("discount_amount") @db.Decimal(12, 2)
  subtotalBefore Decimal @map("subtotal_before") @db.Decimal(12, 2)
  subtotalAfter  Decimal @map("subtotal_after") @db.Decimal(12, 2)
  
  // Status
  status      String    @db.VarChar(50) // applied | expired | failed
  
  // Metadata
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now()) @map("created_at")
  
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([cartId])
  @@index([checkoutId])
  @@index([orderId])
  @@index([customerId])
  @@index([couponCode])
  @@index([createdAt(sort: Desc)])
  @@map("promotion_logs")
}

// ============================================================================
// SHIPPING DOMAIN
// ============================================================================

model ShippingZone {
  id          String   @id @default(uuid())
  name        String   @db.VarChar(255)
  description String?  @db.Text
  
  // Zone coverage (stored as JSONB for flexibility)
  // { countries: ["PK", "US"], regions: ["Punjab", "Sindh"], cities: ["Lahore", "Karachi"] }
  coverage    Json     @default("{}")
  
  // Priority for matching (higher priority zones checked first)
  priority    Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  methods     ShippingMethod[]

  @@index([isActive, priority])
  @@index([priority])
  @@map("shipping_zones")
}

model ShippingMethod {
  id          String   @id @default(uuid())
  zoneId      String   @map("zone_id")
  code        String   @db.VarChar(100) // tcs, leopard, dhl, custom, etc.
  name        String   @db.VarChar(255)
  description String?  @db.Text
  
  // Method type: flat_rate | weight_based | amount_based | courier_api
  type        String   @db.VarChar(50)
  
  // Cost calculation rules (stored as JSONB)
  // For flat_rate: { cost: 100 }
  // For weight_based: { baseCost: 50, costPerKg: 20, minWeight: 0.5, maxWeight: 30 }
  // For amount_based: { freeAbove: 5000, costBelow: 200 }
  // For courier_api: { provider: "tcs", serviceType: "express" }
  config      Json     @default("{}")
  
  // Eligibility constraints
  minOrderAmount Decimal? @map("min_order_amount") @db.Decimal(12, 2)
  maxOrderAmount Decimal? @map("max_order_amount") @db.Decimal(12, 2)
  minWeight      Decimal? @map("min_weight") @db.Decimal(10, 2)
  maxWeight      Decimal? @map("max_weight") @db.Decimal(10, 2)
  
  // Priority within zone (higher priority methods shown first)
  priority    Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  
  // Courier-specific configuration (API credentials, endpoints, etc.)
  courierConfig Json?  @map("courier_config") @default("{}")
  
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  zone        ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  orderShippings OrderShipping[]
  customerGroups ShippingMethodCustomerGroup[]

  @@index([zoneId])
  @@index([code])
  @@index([isActive, priority])
  @@index([type])
  @@map("shipping_methods")
}

model OrderShipping {
  id              String    @id @default(uuid())
  orderId         String    @unique @map("order_id")
  shippingMethodId String   @map("shipping_method_id")
  
  // Shipping cost (snapshot at time of order)
  cost            Decimal   @db.Decimal(12, 2)
  currency        String    @db.VarChar(3)
  
  // Status: pending | shipped | in_transit | delivered | cancelled
  status          String    @default("pending") @db.VarChar(50)
  
  // Tracking information
  trackingNumber  String?   @map("tracking_number") @db.VarChar(255)
  trackingUrl     String?   @map("tracking_url") @db.Text
  
  // Courier provider information (snapshot)
  courierCode     String?   @map("courier_code") @db.VarChar(50)
  courierName     String?   @map("courier_name") @db.VarChar(255)
  
  // Timestamps
  shippedAt       DateTime? @map("shipped_at")
  deliveredAt     DateTime? @map("delivered_at")
  cancelledAt     DateTime? @map("cancelled_at")
  
  // Shipping address (immutable snapshot)
  shippingAddress Json      @map("shipping_address")
  
  // Additional metadata (courier response, delivery notes, etc.)
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shippingMethod  ShippingMethod @relation(fields: [shippingMethodId], references: [id])

  @@index([orderId])
  @@index([shippingMethodId])
  @@index([status])
  @@index([trackingNumber])
  @@index([courierCode])
  @@index([shippedAt])
  @@map("order_shipping")
}

model ShippingMethodCustomerGroup {
  id                String   @id @default(uuid())
  shippingMethodId String   @map("shipping_method_id")
  customerGroupId  String   @map("customer_group_id") @db.Uuid
  
  // Group-specific pricing override (optional)
  // If null, uses default method pricing
  // If set, overrides the base cost calculation for this group
  discountPercent  Decimal? @map("discount_percent") @db.Decimal(5, 2) // Percentage discount (e.g., 10.00 for 10%)
  fixedCost        Decimal? @map("fixed_cost") @db.Decimal(12, 2) // Fixed cost override (overrides all calculations)
  
  // Metadata for additional group-specific rules
  metadata         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  
  shippingMethod   ShippingMethod @relation(fields: [shippingMethodId], references: [id], onDelete: Cascade)
  customerGroup    CustomerGroup @relation(fields: [customerGroupId], references: [id], onDelete: Cascade)

  @@unique([shippingMethodId, customerGroupId])
  @@index([shippingMethodId])
  @@index([customerGroupId])
  @@map("shipping_method_customer_groups")
}

// ============================================================================
// TAX DOMAIN
// ============================================================================

model TaxClass {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(50) // standard | reduced | exempt
  name        String   @db.VarChar(255)
  description String?  @db.Text
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  taxes       Tax[]

  @@index([code])
  @@map("tax_classes")
}

model Tax {
  id              String    @id @default(uuid())
  taxClassId      String    @map("tax_class_id")
  
  // Geographic scope
  country         String    @db.VarChar(2) // ISO 3166-1 alpha-2 (e.g., "US", "PK")
  region          String?   @db.VarChar(100) // State/province (e.g., "CA", "Punjab")
  
  // Tax configuration
  rate            Decimal   @db.Decimal(5, 4) // Stored as percentage (e.g., 20.0000 for 20%)
  isInclusive     Boolean   @default(false) @map("is_inclusive") // true = tax included in price, false = tax added
  isActive        Boolean   @default(true) @map("is_active")
  
  // Validity period
  startDate       DateTime? @map("start_date")
  endDate         DateTime? @map("end_date")
  
  // Metadata (for future VAT/GST compliance fields)
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  taxClass        TaxClass  @relation(fields: [taxClassId], references: [id], onDelete: Cascade)
  orderTaxes      OrderTax[]

  @@index([taxClassId])
  @@index([country, region])
  @@index([isActive])
  @@index([startDate, endDate])
  @@index([country, region, taxClassId, isActive])
  @@map("taxes")
}

model OrderTax {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  taxId           String   @map("tax_id")
  
  // Tax details snapshot (immutable)
  taxClassId      String   @map("tax_class_id")
  taxClassCode    String   @map("tax_class_code") @db.VarChar(50)
  taxClassName    String   @map("tax_class_name") @db.VarChar(255)
  country         String   @map("country") @db.VarChar(2)
  region          String?  @map("region") @db.VarChar(100)
  rate            Decimal  @map("rate") @db.Decimal(5, 4)
  isInclusive     Boolean  @map("is_inclusive")
  
  // Amounts
  taxableAmount   Decimal  @map("taxable_amount") @db.Decimal(12, 2)
  taxAmount       Decimal  @map("tax_amount") @db.Decimal(12, 2)
  
  // Metadata
  metadata        Json     @default("{}")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tax             Tax      @relation(fields: [taxId], references: [id])

  @@index([orderId])
  @@index([taxId])
  @@index([taxClassId])
  @@map("order_taxes")
}

// ============================================================================
// CUSTOMER DOMAIN
// ============================================================================

model CustomerGroup {
  id              String    @id @default(uuid()) @db.Uuid
  name            String    @db.VarChar(255)
  description     String?   @db.Text
  isDefault       Boolean   @default(false) @map("is_default")
  taxClassId      String?   @map("tax_class_id") @db.Uuid
  discountPercent Decimal?   @map("discount_percent") @db.Decimal(5, 2) // Percentage discount (e.g., 10.00 for 10%)
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  customers       Customer[]
  promotionCustomerGroups PromotionCustomerGroup[]
  shippingMethodCustomerGroups ShippingMethodCustomerGroup[]

  @@index([isDefault])
  @@index([taxClassId])
  @@map("customer_groups")
}

model Customer {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(255)
  passwordHash    String?   @map("password_hash") @db.VarChar(255) // null for guest or legacy; set for registered users who can login
  firstName       String?   @map("first_name") @db.VarChar(255)
  lastName        String?   @map("last_name") @db.VarChar(255)
  phone           String?   @db.VarChar(50)
  isGuest         Boolean   @default(false) @map("is_guest")
  customerGroupId String    @map("customer_group_id") @db.Uuid
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  customerGroup   CustomerGroup   @relation(fields: [customerGroupId], references: [id])
  orders          Order[]
  addresses       CustomerAddress[]

  @@index([email])
  @@index([customerGroupId])
  @@index([isGuest])
  @@map("customers")
}

model AccountCreationToken {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @db.VarChar(255)
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([token])
  @@index([expiresAt])
  @@map("account_creation_tokens")
}

model CustomerAddress {
  id               String   @id @default(uuid()) @db.Uuid
  customerId       String   @map("customer_id") @db.Uuid
  label            String?  @db.VarChar(100)
  firstName        String   @map("first_name") @db.VarChar(255)
  lastName         String   @map("last_name") @db.VarChar(255)
  company          String?  @db.VarChar(255)
  addressLine1     String   @map("address_line1") @db.VarChar(500)
  addressLine2     String?  @map("address_line2") @db.VarChar(500)
  city             String   @db.VarChar(255)
  state            String   @db.VarChar(255)
  postalCode       String   @map("postal_code") @db.VarChar(50)
  country          String   @db.VarChar(2)
  phone            String?  @db.VarChar(50)
  isDefaultBilling Boolean  @default(false) @map("is_default_billing")
  isDefaultShipping Boolean @default(false) @map("is_default_shipping")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

// ============================================================================
// ADMIN USERS & RBAC
// ============================================================================

model AdminPermission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(120)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  roles AdminRolePermission[]

  @@map("admin_permissions")
}

model AdminRole {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(128)
  description String?  @db.Text
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions AdminRolePermission[]
  users       AdminUserRole[]

  @@map("admin_roles")
}

model AdminRolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("admin_role_permissions")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String?   @map("first_name") @db.VarChar(255)
  lastName     String?   @map("last_name") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  roles AdminUserRole[]

  @@index([email])
  @@index([isActive])
  @@map("admin_users")
}

model AdminUserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role AdminRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("admin_user_roles")
}

// ============================================================================
// CMS DOMAIN
// ============================================================================

model CmsPage {
  id              String    @id @default(uuid())
  title           String    @db.VarChar(255)
  slug            String    @unique @db.VarChar(255)
  status          String    @default("draft") @db.VarChar(32) // draft | published
  excerpt         String?   @db.Text
  metaTitle       String?   @map("meta_title") @db.VarChar(255)
  metaDescription String?   @map("meta_description") @db.Text
  contentHtml     String?   @map("content_html") @db.Text
  contentJson     Json?     @map("content_json") @default("{}")
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([slug, status])
  @@index([status, updatedAt(sort: Desc)])
  @@map("cms_pages")
}

model CmsBlock {
  id           String   @id @default(uuid())
  name         String   @db.VarChar(255)
  identifier   String   @unique @db.VarChar(255)
  description  String?  @db.Text
  contentHtml  String?  @map("content_html") @db.Text
  contentJson  Json?    @map("content_json") @default("{}")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([identifier, isActive])
  @@map("cms_blocks")
}

model CmsBannerSlider {
  id          String           @id @default(uuid())
  name        String           @db.VarChar(255)
  identifier  String           @unique @db.VarChar(255)
  isActive    Boolean          @default(true) @map("is_active")
  autoplayMs  Int?             @map("autoplay_ms")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  slides      CmsBannerSlide[]

  @@index([identifier, isActive])
  @@map("cms_banner_sliders")
}

model CmsBannerSlide {
  id          String          @id @default(uuid())
  sliderId    String          @map("slider_id")
  title       String          @db.VarChar(255)
  subtitle    String?         @db.Text
  imageUrl    String          @map("image_url") @db.Text
  ctaLabel    String?         @map("cta_label") @db.VarChar(120)
  ctaHref     String?         @map("cta_href") @db.VarChar(500)
  sortOrder   Int             @default(0) @map("sort_order")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  slider      CmsBannerSlider @relation(fields: [sliderId], references: [id], onDelete: Cascade)

  @@index([sliderId, sortOrder])
  @@index([sliderId, isActive])
  @@map("cms_banner_slides")
}
