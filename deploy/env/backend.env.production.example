# Generated by deploy/scripts/install-env.sh — reference only
# Copy from demo.env; do not commit backend/.env

NODE_ENV=production
PORT=3000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ecommerce?schema=public"

JWT_SECRET="REPLACE"
JWT_EXPIRES_IN=7d
BOOTSTRAP_TOKEN="REPLACE"
# Encrypts SMTP passwords in Admin → Mail (openssl rand -hex 32). Keep stable after saving mailboxes.
MAIL_ENCRYPTION_KEY="REPLACE"
MAIL_ENABLED=true

CORS_ORIGIN=https://shop.yourdomain.com,https://admin.yourdomain.com
FRONTEND_URL=https://shop.yourdomain.com
APP_URL=https://api.yourdomain.com
PUBLIC_BASE_URL=https://api.yourdomain.com

DEFAULT_CURRENCY=PKR
APP_CURRENCY=PKR

REDIS_ENABLED=false
