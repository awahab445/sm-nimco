# Generated by deploy/scripts/install-env.sh — reference only
# Copy from demo.env; do not commit backend/.env

NODE_ENV=production
PORT=3000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ecommerce?schema=public"

JWT_SECRET="REPLACE"
JWT_EXPIRES_IN=7d
BOOTSTRAP_TOKEN="REPLACE"
# Encrypts SMTP passwords in Admin → Mail (openssl rand -hex 32). Keep stable after saving mailboxes.
MAIL_ENCRYPTION_KEY="REPLACE"
MAIL_ENABLED=true

# Meta Conversions API (Direct) — optional; never expose to browsers
# META_CAPI_ACCESS_TOKEN=
# META_CAPI_TEST_EVENT_CODE=

CORS_ORIGIN=https://shop.yourdomain.com,https://admin.yourdomain.com
FRONTEND_URL=https://shop.yourdomain.com
APP_URL=https://api.yourdomain.com
PUBLIC_BASE_URL=https://api.yourdomain.com

DEFAULT_CURRENCY=PKR
APP_CURRENCY=PKR

REDIS_ENABLED=false

# Leopards Courier Merchant API (production) — set real values on the server only
# LEOPARDS_API_URL=https://merchantapi.leopardscourier.com/api/
# LEOPARDS_API_KEY=
# LEOPARDS_API_PASSWORD=
# LEOPARDS_ORIGIN_CITY_ID=592
# LEOPARDS_SHIPPER_ID=2792661
# LEOPARDS_SHIPPER_NAME=SM Nimco & Sweets
# LEOPARDS_SHIPPER_EMAIL=info@smnimco.com
