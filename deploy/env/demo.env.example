# Copy to deploy/env/demo.env and fill in before install-env.sh / configure-nginx.sh
# Do not commit deploy/env/demo.env

# --- Domains (no trailing slash) ---
SHOP_DOMAIN=shop.yourdomain.com
ADMIN_DOMAIN=admin.yourdomain.com
API_DOMAIN=api.yourdomain.com

# --- PostgreSQL (local on VPS) ---
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Backend secrets ---
JWT_SECRET=change-me-use-openssl-rand-hex-32
BOOTSTRAP_TOKEN=change-me-bootstrap-token-before-deploy
# Flushes storefront ISR after deploy (defaults to JWT_SECRET in install-env.sh if unset)
REVALIDATE_SECRET=change-me-use-openssl-rand-hex-32
# Encrypts Admin → Mail SMTP passwords (defaults to JWT_SECRET in install-env.sh if unset)
MAIL_ENCRYPTION_KEY=change-me-use-openssl-rand-hex-32
MAIL_ENABLED=true
DEFAULT_CURRENCY=PKR

# --- First admin user (bootstrap-demo.sh) ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_FIRST_NAME=Demo
ADMIN_LAST_NAME=Admin

# --- Storefront branding (optional) ---
NEXT_PUBLIC_STORE_THEME=mehfil_shereen
NEXT_PUBLIC_CURRENCY=PKR
NEXT_PUBLIC_STOREFRONT_HOME_LAYOUT_IDENTIFIER=home-page-layout

# --- TLS (configure-nginx.sh) ---
CERTBOT_EMAIL=you@yourdomain.com
