# Copy to deploy/env/docker.env and fill in before docker compose up
# Do not commit deploy/env/docker.env

# --- Domains (no trailing slash) ---
SHOP_DOMAIN=shop.mystore.test
ADMIN_DOMAIN=admin.mystore.test
API_DOMAIN=api.mystore.test

# --- Public URLs (http:// for Phase 1 local hosts testing, https:// for production) ---
SHOP_URL=http://shop.mystore.test
ADMIN_URL=http://admin.mystore.test
API_URL=http://api.mystore.test

# --- Host ports (bind on 127.0.0.1; change if 3000–3002 are already in use) ---
HOST_API_PORT=3100
HOST_STOREFRONT_PORT=3101
HOST_ADMIN_PORT=3102

# --- PostgreSQL (Docker container) ---
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=change-me-strong-db-password

# --- Backend secrets (JWT_SECRET must be 32+ chars) ---
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
BOOTSTRAP_TOKEN=change-me-bootstrap-token-before-deploy
# Used by deploy scripts to flush storefront ISR after release (openssl rand -hex 32)
REVALIDATE_SECRET=change-me-use-openssl-rand-hex-32
# Encrypts SMTP passwords in Admin → Mail. Must stay stable once mailboxes are saved.
# Generate: openssl rand -hex 32  (or leave unset to fall back to JWT_SECRET in compose)
MAIL_ENCRYPTION_KEY=change-me-use-openssl-rand-hex-32
MAIL_ENABLED=true
DEFAULT_CURRENCY=PKR

# Meta Conversions API (Direct) — Graph API access token for Pixel server events.
# Do not commit the real token. Leave blank until Events Manager Direct setup is done.
# META_CAPI_ACCESS_TOKEN=
# META_CAPI_TEST_EVENT_CODE=

# --- Cookie domain (leave empty for HTTP/local testing; set .yourdomain.com for HTTPS) ---
COOKIE_DOMAIN=

# --- Session cookies (false for HTTP, true after HTTPS / Certbot) ---
COOKIE_SECURE=false

# --- First admin user (bootstrap.sh) ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_FIRST_NAME=Demo
ADMIN_LAST_NAME=Admin

# --- Storefront branding (build args) ---
NEXT_PUBLIC_CURRENCY=PKR
NEXT_PUBLIC_STORE_THEME=mehfil_shereen
NEXT_PUBLIC_STOREFRONT_HOME_LAYOUT_IDENTIFIER=home-page-layout
NEXT_PUBLIC_ADMIN_APP_NAME="Ecommerce Admin"

# --- TLS (Phase 2 — host Nginx + Certbot) ---
CERTBOT_EMAIL=you@yourdomain.com

# --- Bootstrap ---
SEED_DEMO_DATA=true
SKIP_BOOTSTRAP=false
