# Local Docker — copy to deploy/env/docker.env
# Access apps directly by port (no Nginx, no /etc/hosts required)
#
#   Shop:       http://localhost:3101
#   Admin:      http://localhost:3102
#   API:        http://localhost:3100
#
# After changing SHOP_URL / ADMIN_URL / API_URL you must rebuild frontends:
#   bash deploy/docker/compose.sh build storefront admin

# --- Domains (informational for Nginx on VPS; use localhost locally) ---
SHOP_DOMAIN=localhost
ADMIN_DOMAIN=localhost
API_DOMAIN=localhost

# --- Public URLs (must match HOST_* ports below) ---
SHOP_URL=http://localhost:3101
ADMIN_URL=http://localhost:3102
API_URL=http://localhost:3100

# --- Host ports (bind on 127.0.0.1) ---
HOST_API_PORT=3100
HOST_STOREFRONT_PORT=3101
HOST_ADMIN_PORT=3102

# --- PostgreSQL (Docker container) ---
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=local-dev-password

# --- Backend secrets ---
JWT_SECRET=local-dev-jwt-secret-min-32-characters-long
JWT_EXPIRES_IN=7d
BOOTSTRAP_TOKEN=local-dev-bootstrap-token
REVALIDATE_SECRET=local-dev-revalidate-secret-min-32-chars
DEFAULT_CURRENCY=PKR

COOKIE_DOMAIN=
COOKIE_SECURE=false

ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=admin123456
ADMIN_FIRST_NAME=Local
ADMIN_LAST_NAME=Admin

NEXT_PUBLIC_CURRENCY=PKR
NEXT_PUBLIC_STORE_THEME=mehfil_shereen
NEXT_PUBLIC_STOREFRONT_HOME_LAYOUT_IDENTIFIER=home-page-layout
NEXT_PUBLIC_ADMIN_APP_NAME="Ecommerce Admin"

CERTBOT_EMAIL=dev@localhost

SEED_DEMO_DATA=true
SKIP_BOOTSTRAP=false
