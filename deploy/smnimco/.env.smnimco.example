# Copy to deploy/smnimco/.env.smnimco and fill secrets before docker compose up.
# Do not commit deploy/smnimco/.env.smnimco
#
# Generate secrets:
#   openssl rand -hex 32

# --- Domains (no trailing slash) ---
SHOP_DOMAIN=smnimco.com
WWW_DOMAIN=www.smnimco.com
ADMIN_DOMAIN=admin.smnimco.com
API_DOMAIN=api.smnimco.com

# --- Public URLs (HTTPS in production; no trailing slash) ---
SHOP_URL=https://smnimco.com
WWW_URL=https://www.smnimco.com
ADMIN_URL=https://admin.smnimco.com
API_URL=https://api.smnimco.com

# --- Host ports (127.0.0.1 only; avoids clash with M. Essa 3100–3102) ---
HOST_API_PORT=3200
HOST_STOREFRONT_PORT=3201
HOST_ADMIN_PORT=3202
HOST_POSTGRES_PORT=5433
HOST_REDIS_PORT=6380

# --- PostgreSQL (Docker service smnimco-postgres) ---
POSTGRES_DB=smnimco
POSTGRES_USER=smnimco
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-16

# --- Backend secrets (JWT_SECRET must be 32+ chars in production) ---
NODE_ENV=production
JWT_SECRET=replace-with-openssl-rand-hex-32
JWT_EXPIRES_IN=7d
BOOTSTRAP_TOKEN=replace-with-openssl-rand-hex-32
REVALIDATE_SECRET=replace-with-openssl-rand-hex-32
MAIL_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
MAIL_ENABLED=true
DEFAULT_CURRENCY=PKR

# Meta Conversions API (optional — leave blank until Events Manager is configured)
# META_CAPI_ACCESS_TOKEN=
# META_CAPI_TEST_EVENT_CODE=

# --- Cookies (HTTPS production) ---
COOKIE_DOMAIN=.smnimco.com
COOKIE_SECURE=true

# --- Store / email branding ---
STORE_NAME=SM NIMCO & Sweets
STORE_LOGO_URL=https://api.smnimco.com/uploads/site-config/logo.png
STORE_SOCIAL_FACEBOOK=
STORE_SOCIAL_INSTAGRAM=
STORE_SOCIAL_TWITTER=
STORE_SOCIAL_LINKEDIN=

# --- First admin user (manual bootstrap / seed helpers) ---
ADMIN_EMAIL=admin@smnimco.com
ADMIN_PASSWORD=replace-with-strong-admin-password
ADMIN_FIRST_NAME=Store
ADMIN_LAST_NAME=Admin

# --- Storefront / admin build-time args (baked into Next.js images) ---
NEXT_PUBLIC_CURRENCY=PKR
NEXT_PUBLIC_STORE_THEME=sm_nimco
NEXT_PUBLIC_STOREFRONT_HOME_LAYOUT_IDENTIFIER=home-page-layout
NEXT_PUBLIC_ADMIN_APP_NAME=SM NIMCO Admin

# --- TLS (Certbot) ---
CERTBOT_EMAIL=ops@smnimco.com

# --- Bootstrap ---
SEED_DEMO_DATA=true
SKIP_BOOTSTRAP=false
