# Copy to .env.local and adjust if needed.
# Backend API base URL (no trailing slash). Must match backend PORT (default 3000).
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_CURRENCY=PKR

# Official WhatsApp support / order number (digits only or wa.me URL)
NEXT_PUBLIC_WHATSAPP_PHONE=923442394143
NEXT_PUBLIC_STORE_SOCIAL_WHATSAPP=https://wa.me/923442394143
NEXT_PUBLIC_STORE_PHONE=+92 344 2394143
